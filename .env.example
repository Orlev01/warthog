# Copy to .env.local for local development. Never commit real values.
PUBLIC_BASE_URL=http://localhost:3000
# The admin portal is served on a derived host (app. -> admin.; here http://admin.localhost:3000,
# which Chrome, Firefox and Node resolve to loopback). ADMIN_BASE_URL may override it outside
# production only; production refuses it. Set OPERATOR_EMAIL to your own sign-up address to be
# promoted to admin by the hourly operator-role sweep.
# ADMIN_BASE_URL=http://admin.localhost:3000
# OPERATOR_EMAIL=you@example.test
WEBAUTHN_RP_ID=localhost
DATABASE_URL=pglite:./.data/dev
# Dev-only tools (outbox, sign-in-as). The production server refuses to start with this set.
WARTHOG_DEV_TOOLS=1
# DEV-ONLY server secrets, generated for local development and published with the repo, so they
# protect nothing. Production sets its own WARTHOG_HMAC_KEY and refuses WARTHOG_DEV_KEK (data keys
# are wrapped by Key Vault there).
WARTHOG_HMAC_KEY=BNDuwj5gFfGTaY2mJgdOm8pKD/XMGoUVL38CiznX2UNO66/UqaGshgBQsB8bizNb
WARTHOG_DEV_KEK=Q/h6jg7RDmNAS+QtFzC0g9dmZDJMMYyM+Cd9fOl4D0E=

# Production messaging contract: docs/production-release.md. No real secret or
# spending default belongs in this example. Dev tools above still use the outbox.
# RESEND_API_KEY, RESEND_FROM_ADDRESS, RESEND_SENDING_DOMAIN, RESEND_REPLY_TO_ADDRESS
# TWILIO_ACCOUNT_SID, TWILIO_API_KEY_SID, TWILIO_API_KEY_SECRET, TWILIO_REGION
# SMS_ENABLED=false explicitly disables SMS enrolment and delivery. Omission means true.
# Email and Web Push remain required in production; SMS settings below apply only when enabled.
# SMS_COUNTRY_ROUTES_JSON (approved ISO country -> two-way Messaging Service SID)
# SMS_MONTHLY_SEGMENT_LIMIT, SMS_DAILY_SEGMENT_LIMIT
# SMS_RECIPIENT_HOURLY_SEGMENT_LIMIT, SMS_RECIPIENT_DAILY_MESSAGE_LIMIT
# SMS_MAX_SEGMENTS_PER_MESSAGE
# Production requires all of these explicitly; no countries are enabled by default.
