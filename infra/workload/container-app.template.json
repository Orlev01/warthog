{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Review-only Warthog workload. Manual stop/wait/start required. Applying creates a running paid app; this file is not approval. No custom domain/DNS/credentials are created."
  },
  "parameters": {
    "deploymentApproved": {
      "type": "bool",
      "metadata": {
        "description": "Explicit approval of this workload, cost, credentials and maintenance window. The value is an attestation, not authorization."
      },
      "allowedValues": [
        true
      ]
    },
    "priorReplicasStopped": {
      "type": "bool",
      "metadata": {
        "description": "All prior revisions inactive and replica lists empty; database ownership lock checked and released immediately before this operation."
      },
      "allowedValues": [
        true
      ]
    },
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Reviewed new/existing app resource name in the dedicated Warthog resource group."
      }
    },
    "environmentResourceId": {
      "type": "string",
      "metadata": {
        "description": "Existing approved Australia East Consumption environment resource ID; creates no environment."
      }
    },
    "managedIdentityResourceId": {
      "type": "string",
      "metadata": {
        "description": "Existing identity resource ID with scoped ACR/KV/Blob permissions."
      }
    },
    "managedIdentityClientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID of that same user-assigned identity, not a credential."
      }
    },
    "registryServer": {
      "type": "string",
      "metadata": {
        "description": "Existing reviewed Azure Container Registry login server, without a URL scheme."
      }
    },
    "imageDigest": {
      "type": "string",
      "metadata": {
        "description": "Approved linux/amd64 registry/repository@sha256:digest, never a mutable tag."
      }
    },
    "revisionSuffix": {
      "type": "string",
      "metadata": {
        "description": "Unique reviewed suffix; the revision name is appName--revisionSuffix."
      }
    },
    "cpu": {
      "type": "string",
      "metadata": {
        "description": "Explicitly approve the proposed resource allocation; no paid default selected."
      },
      "allowedValues": [
        "0.5"
      ]
    },
    "memory": {
      "type": "string",
      "metadata": {
        "description": "Explicitly approve the proposed resource allocation; no paid default selected."
      },
      "allowedValues": [
        "1Gi"
      ]
    },
    "productionEnvironment": {
      "type": "object",
      "metadata": {
        "description": "Only documented nonsecret settings from the application contract. No credentials, database URLs or private test-account list."
      }
    },
    "keyVaultSecretUrls": {
      "type": "object",
      "metadata": {
        "description": "Version-pinned existing Key Vault SECRET URLs keyed by environment name; never secret values. URLs include /secrets/name/version."
      }
    },
    "traffic": {
      "type": "array",
      "metadata": {
        "description": "Exactly one explicit new revisionName at weight100; no latestRevision, inactive old target or split traffic. Set only after stop/wait/ownership evidence. The new app may serve as soon as its health probes pass."
      }
    },
    "existingCustomDomains": {
      "type": "array",
      "metadata": {
        "description": "First creation: explicit empty array. Updates: exact existing approved app custom-domain bindings, copied without changes. No new domain/certificate binding is authorized here."
      }
    },
    "smsEnabled": {
      "type": "bool",
      "metadata": {
        "description": "Explicit SMS capability. False omits all Twilio secret references and SMS provider settings. Enabling requires reviewed routes, limits, provider readiness and release approval."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[parameters('appName')]",
      "location": "australiaeast",
      "tags": {
        "application": "warthog",
        "environment": "production"
      },
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": "[createObject(parameters('managedIdentityResourceId'), json('{}'))]"
      },
      "properties": {
        "environmentId": "[parameters('environmentResourceId')]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Multiple",
          "ingress": {
            "external": true,
            "allowInsecure": false,
            "targetPort": 3000,
            "transport": "http",
            "traffic": "[parameters('traffic')]",
            "customDomains": "[parameters('existingCustomDomains')]"
          },
          "registries": [
            {
              "server": "[parameters('registryServer')]",
              "identity": "[parameters('managedIdentityResourceId')]"
            }
          ],
          "secrets": "[concat(variables('baseSecrets'), if(parameters('smsEnabled'), variables('smsSecrets'), json('[]')))]"
        },
        "template": {
          "revisionSuffix": "[parameters('revisionSuffix')]",
          "terminationGracePeriodSeconds": 30,
          "containers": [
            {
              "name": "warthog",
              "image": "[parameters('imageDigest')]",
              "env": "[concat(variables('baseEnvironment'), if(parameters('smsEnabled'), variables('smsEnvironment'), json('[]')))]",
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 60,
                  "timeoutSeconds": 5,
                  "failureThreshold": 10,
                  "successThreshold": 1
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3,
                  "successThreshold": 1
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/api/health/live",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3,
                  "successThreshold": 1
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1,
            "rules": []
          }
        }
      }
    }
  ],
  "variables": {
    "baseEnvironment": [
      {
        "name": "NODE_ENV",
        "value": "production"
      },
      {
        "name": "PORT",
        "value": "3000"
      },
      {
        "name": "HOSTNAME",
        "value": "0.0.0.0"
      },
      {
        "name": "SMS_ENABLED",
        "value": "[if(parameters('smsEnabled'), 'true', 'false')]"
      },
      {
        "name": "AZURE_CLIENT_ID",
        "value": "[parameters('managedIdentityClientId')]"
      },
      {
        "name": "PUBLIC_BASE_URL",
        "value": "[string(parameters('productionEnvironment').PUBLIC_BASE_URL)]"
      },
      {
        "name": "WEBAUTHN_RP_ID",
        "value": "[string(parameters('productionEnvironment').WEBAUTHN_RP_ID)]"
      },
      {
        "name": "OPERATOR_EMAIL",
        "value": "[string(parameters('productionEnvironment').OPERATOR_EMAIL)]"
      },
      {
        "name": "EXCHANGE_RATE_BASE_URL",
        "value": "[string(parameters('productionEnvironment').EXCHANGE_RATE_BASE_URL)]"
      },
      {
        "name": "KEY_VAULT_URL",
        "value": "[string(parameters('productionEnvironment').KEY_VAULT_URL)]"
      },
      {
        "name": "KEY_VAULT_KEY_NAME",
        "value": "[string(parameters('productionEnvironment').KEY_VAULT_KEY_NAME)]"
      },
      {
        "name": "STORAGE_ACCOUNT",
        "value": "[string(parameters('productionEnvironment').STORAGE_ACCOUNT)]"
      },
      {
        "name": "STORAGE_CONTAINER",
        "value": "[string(parameters('productionEnvironment').STORAGE_CONTAINER)]"
      },
      {
        "name": "DELETION_JOURNAL_CONTAINER",
        "value": "[string(parameters('productionEnvironment').DELETION_JOURNAL_CONTAINER)]"
      },
      {
        "name": "RESEND_FROM_ADDRESS",
        "value": "[string(parameters('productionEnvironment').RESEND_FROM_ADDRESS)]"
      },
      {
        "name": "RESEND_SENDING_DOMAIN",
        "value": "[string(parameters('productionEnvironment').RESEND_SENDING_DOMAIN)]"
      },
      {
        "name": "RESEND_REPLY_TO_ADDRESS",
        "value": "[string(parameters('productionEnvironment').RESEND_REPLY_TO_ADDRESS)]"
      },
      {
        "name": "GOOGLE_CLIENT_ID",
        "value": "[string(parameters('productionEnvironment').GOOGLE_CLIENT_ID)]"
      },
      {
        "name": "MICROSOFT_CLIENT_ID",
        "value": "[string(parameters('productionEnvironment').MICROSOFT_CLIENT_ID)]"
      },
      {
        "name": "VAPID_SUBJECT",
        "value": "[string(parameters('productionEnvironment').VAPID_SUBJECT)]"
      },
      {
        "name": "VAPID_PUBLIC_KEY",
        "value": "[string(parameters('productionEnvironment').VAPID_PUBLIC_KEY)]"
      },
      {
        "name": "DATABASE_URL",
        "secretRef": "database-url"
      },
      {
        "name": "MIGRATION_DATABASE_URL",
        "secretRef": "migration-database-url"
      },
      {
        "name": "PURGE_DATABASE_URL",
        "secretRef": "purge-database-url"
      },
      {
        "name": "WARTHOG_HMAC_KEY",
        "secretRef": "warthog-hmac-key"
      },
      {
        "name": "RESEND_API_KEY",
        "secretRef": "resend-api-key"
      },
      {
        "name": "GOOGLE_CLIENT_SECRET",
        "secretRef": "google-client-secret"
      },
      {
        "name": "MICROSOFT_CLIENT_SECRET",
        "secretRef": "microsoft-client-secret"
      },
      {
        "name": "GOOGLE_EARLY_ACCESS",
        "secretRef": "google-early-access"
      },
      {
        "name": "VAPID_PRIVATE_KEY",
        "secretRef": "vapid-private-key"
      }
    ],
    "smsEnvironment": [
      {
        "name": "TWILIO_REGION",
        "value": "[if(parameters('smsEnabled'), string(parameters('productionEnvironment').TWILIO_REGION), '')]"
      },
      {
        "name": "SMS_COUNTRY_ROUTES_JSON",
        "value": "[if(parameters('smsEnabled'), string(parameters('productionEnvironment').SMS_COUNTRY_ROUTES_JSON), '')]"
      },
      {
        "name": "SMS_MONTHLY_SEGMENT_LIMIT",
        "value": "[if(parameters('smsEnabled'), string(parameters('productionEnvironment').SMS_MONTHLY_SEGMENT_LIMIT), '')]"
      },
      {
        "name": "SMS_DAILY_SEGMENT_LIMIT",
        "value": "[if(parameters('smsEnabled'), string(parameters('productionEnvironment').SMS_DAILY_SEGMENT_LIMIT), '')]"
      },
      {
        "name": "SMS_RECIPIENT_HOURLY_SEGMENT_LIMIT",
        "value": "[if(parameters('smsEnabled'), string(parameters('productionEnvironment').SMS_RECIPIENT_HOURLY_SEGMENT_LIMIT), '')]"
      },
      {
        "name": "SMS_RECIPIENT_DAILY_MESSAGE_LIMIT",
        "value": "[if(parameters('smsEnabled'), string(parameters('productionEnvironment').SMS_RECIPIENT_DAILY_MESSAGE_LIMIT), '')]"
      },
      {
        "name": "SMS_MAX_SEGMENTS_PER_MESSAGE",
        "value": "[if(parameters('smsEnabled'), string(parameters('productionEnvironment').SMS_MAX_SEGMENTS_PER_MESSAGE), '')]"
      },
      {
        "name": "TWILIO_ACCOUNT_SID",
        "secretRef": "twilio-account-sid"
      },
      {
        "name": "TWILIO_API_KEY_SID",
        "secretRef": "twilio-api-key-sid"
      },
      {
        "name": "TWILIO_API_KEY_SECRET",
        "secretRef": "twilio-api-key-secret"
      }
    ],
    "baseSecrets": [
      {
        "name": "database-url",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').DATABASE_URL]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "migration-database-url",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').MIGRATION_DATABASE_URL]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "purge-database-url",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').PURGE_DATABASE_URL]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "warthog-hmac-key",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').WARTHOG_HMAC_KEY]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "resend-api-key",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').RESEND_API_KEY]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "google-client-secret",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').GOOGLE_CLIENT_SECRET]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "microsoft-client-secret",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').MICROSOFT_CLIENT_SECRET]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "google-early-access",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').GOOGLE_EARLY_ACCESS]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "vapid-private-key",
        "keyVaultUrl": "[parameters('keyVaultSecretUrls').VAPID_PRIVATE_KEY]",
        "identity": "[parameters('managedIdentityResourceId')]"
      }
    ],
    "smsSecrets": [
      {
        "name": "twilio-account-sid",
        "keyVaultUrl": "[if(parameters('smsEnabled'), parameters('keyVaultSecretUrls').TWILIO_ACCOUNT_SID, '')]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "twilio-api-key-sid",
        "keyVaultUrl": "[if(parameters('smsEnabled'), parameters('keyVaultSecretUrls').TWILIO_API_KEY_SID, '')]",
        "identity": "[parameters('managedIdentityResourceId')]"
      },
      {
        "name": "twilio-api-key-secret",
        "keyVaultUrl": "[if(parameters('smsEnabled'), parameters('keyVaultSecretUrls').TWILIO_API_KEY_SECRET, '')]",
        "identity": "[parameters('managedIdentityResourceId')]"
      }
    ]
  }
}
