# No trailing slash: a symlinked node_modules (shared across clones) must be ignored too.
node_modules
.next/
.runtime/
next-env.d.ts
*.tsbuildinfo
dist/
/build/
# Skynet's per-job state — must be ignored in full (OBS-4): the build loop needs it untracked.
.agent/
# Local data (PGlite dev database, local blob store)
.data/
.env
.env.*
!.env.example
*.log
.DS_Store
# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
.claude/settings.local.json
.claude/worktrees/
.claude/napkin.md
__pycache__/
*.pyc
# Private delivery inputs and evidence must never be published.
*.tfvars.json
*.tfbackend
*.parameters.json
.delivery/
